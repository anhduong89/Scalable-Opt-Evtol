% --- encoding
remain_cust(E,N-P) :- request(_,E,N), P=#sum{W,D,X: flight(D,E,W,X)}, edge(E).

total_remain(W) :- W = #sum{P,E:remain_cust(E,P)}.
wasted(F) :- F = #count{(L,L'),D,X : flight(D,(L,L'), 0, X), L!=L'}.
revenue(D,X,W*S) :- flight(D,E,W,X), distance(E,S).
total_revenue(TR/2) :- TR= #sum{R,D,X:revenue(D,X,R)}.
% #show remain_cust/2.
#show total_remain/1.
#show wasted/1.
#show total_revenue/1.
